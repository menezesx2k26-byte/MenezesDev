# Never commit real secrets.
# This file documents variable names only.

# Optional: OmniRoute local/remote credential.
OMNIROUTE_API_KEY=

# Optional local endpoint. The default OmniRoute local API is:
OMNIROUTE_BASE_URL=http://localhost:20128/v1

# MenezesDev public runtime environment.
PUBLIC_SITE_URL=
PUBLIC_DEPLOY_ENV=development

# Studio local-only authentication bypass for development/test environments.
# Never enable this in preview or production.
STUDIO_LOCAL_AUTH_BYPASS=
