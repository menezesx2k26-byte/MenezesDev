{
  "name": "menezesdev",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build:site": "astro build",
    "check:routes": "node scripts/check-routes.mjs",
    "check:acceptance": "node scripts/check-acceptance.mjs",
    "check:release": "node scripts/check-release.mjs",
    "build": "astro check && astro build && node scripts/check-routes.mjs",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "prettier --check . && astro check && astro build && node scripts/check-routes.mjs && node scripts/check-acceptance.mjs"
  },
  "dependencies": {
    "@astrojs/react": "6.0.4",
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.2.4",
    "lucide-astro": "0.556.0",
    "motion": "13.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
