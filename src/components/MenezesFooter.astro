---
import CommercialAction from "./CommercialAction.astro";
import { siteConfig } from "../config/site";

interface NavigationItem {
  label: string;
  href: string;
}

interface Props {
  navigation?: NavigationItem[] | undefined;
  whatsappUrl?: string | null | undefined;
  tagline?: string;
}

const {
  navigation = [...siteConfig.navigation],
  whatsappUrl = siteConfig.commercial.whatsappUrl,
  tagline = siteConfig.tagline,
} = Astro.props;
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div>
        <img
          class="md-logo-footer"
          src="/assets/brand/logo-dark.png"
          width="2172"
          height="724"
          alt="MenezesDev"
          loading="lazy"
        />
        <p><strong>{tagline}</strong></p>
        <p class="lead">
          Design e desenvolvimento web para empresas e profissionais que querem uma presença digital
          mais profissional.
        </p>
      </div>
      <nav class="site-footer__links" aria-label="Navegação do rodapé">
        <strong>Navegação</strong>
        {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <div class="site-footer__links">
        <strong>Serviços</strong>
        <span>Landing Pages</span>
        <span>Sites institucionais</span>
        <span>Catálogos</span>
        <span>Integrações</span>
        <span>Projetos personalizados</span>
        <CommercialAction label="Solicitar orçamento" showPendingNote href={whatsappUrl} />
      </div>
    </div>
    <div class="site-footer__bottom">
      <span>© 2026 MenezesDev. Todos os direitos reservados.</span>
      <span>{tagline}</span>
    </div>
  </div>
</footer>
