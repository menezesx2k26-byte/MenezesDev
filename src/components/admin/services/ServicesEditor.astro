---
import { STUDIO_LIMITS } from "../../../studio/validation";
import type { StudioService } from "../../../studio/types";

interface Props {
  services: StudioService[];
}

const { services } = Astro.props;
---

<section class="admin-panel admin-panel--full" aria-labelledby="services-editor-heading">
  <div class="admin-page-heading">
    <p class="admin-kicker">Serviços</p>
    <h2 id="services-editor-heading">O que você oferece.</h2>
    <p>
      Reordene, edite e controle a visibilidade. Pelo menos um serviço precisa permanecer visível.
    </p>
  </div>

  <div class="studio-repeater">
    {
      services.map((service, index) => (
        <article class="studio-repeater__item" data-service-card={service.id}>
          <div class="admin-page-heading">
            <p class="admin-kicker">{service.visible ? "Visível" : "Oculto"}</p>
            <h3>{service.title}</h3>
          </div>

          <div class="admin-shortcuts" aria-label={`Ordem de ${service.title}`}>
            <button
              type="button"
              class="admin-button admin-button--quiet"
              data-business-action="service-move-up"
              data-business-id={service.id}
              disabled={index === 0}
            >
              Mover para cima
            </button>
            <button
              type="button"
              class="admin-button admin-button--quiet"
              data-business-action="service-move-down"
              data-business-id={service.id}
              disabled={index === services.length - 1}
            >
              Mover para baixo
            </button>
          </div>

          <div class="studio-fields-grid">
            <label class="studio-field">
              <span>Título</span>
              <input
                type="text"
                maxlength={STUDIO_LIMITS.longText}
                value={service.title}
                data-business-path={`home.services.items.${index}.title`}
              />
            </label>

            <label class="studio-field">
              <span>Visibilidade</span>
              <span>
                <input
                  type="checkbox"
                  checked={service.visible}
                  data-service-visible
                  data-business-id={service.id}
                />
                Visível no site
              </span>
            </label>

            <label class="studio-field studio-field--wide">
              <span>Descrição</span>
              <textarea
                rows="4"
                maxlength={STUDIO_LIMITS.longText}
                data-business-path={`home.services.items.${index}.text`}
              >
                {service.text}
              </textarea>
            </label>

            {service.microcopy !== undefined ? (
              <label class="studio-field studio-field--wide">
                <span>Microcopy</span>
                <input
                  type="text"
                  maxlength={STUDIO_LIMITS.longText}
                  value={service.microcopy}
                  data-business-path={`home.services.items.${index}.microcopy`}
                />
              </label>
            ) : null}
          </div>
        </article>
      ))
    }
  </div>

  <p class="studio-save-state" data-business-save-status aria-live="polite">
    Rascunho sincronizado.
  </p>
</section>
