---
import PropertyPanel from "../PropertyPanel.astro";
import { STUDIO_LIMITS } from "../../../../studio/validation";
import type { HomeContactSection } from "../../../../studio/types";

interface Props {
  section: HomeContactSection;
}

const { section } = Astro.props;
---

<PropertyPanel sectionKey="contact" title="Contato" visible={section.visible} layout={section.layout}>
  <div class="studio-fields-grid">
    <label class="studio-field">
      <span>Chamada curta</span>
      <input type="text" maxlength={STUDIO_LIMITS.longText} value={section.eyebrow} data-studio-path="home.contact.eyebrow" />
    </label>
    <label class="studio-field studio-field--wide">
      <span>Título</span>
      <textarea maxlength={STUDIO_LIMITS.longText} rows="3" data-studio-path="home.contact.title">{section.title}</textarea>
    </label>
    <label class="studio-field studio-field--wide">
      <span>Texto de apoio</span>
      <textarea maxlength={STUDIO_LIMITS.longText} rows="3" data-studio-path="home.contact.lead">{section.lead}</textarea>
    </label>
    <label class="studio-field studio-field--wide">
      <span>Corpo</span>
      <textarea maxlength={STUDIO_LIMITS.longText} rows="4" data-studio-path="home.contact.body">{section.body}</textarea>
    </label>
    <label class="studio-field studio-field--wide">
      <span>Destaque</span>
      <textarea maxlength={STUDIO_LIMITS.longText} rows="2" data-studio-path="home.contact.emphasis">{section.emphasis}</textarea>
    </label>
    <label class="studio-field">
      <span>Botão principal</span>
      <input type="text" maxlength={STUDIO_LIMITS.longText} value={section.primaryCtaLabel} data-studio-path="home.contact.primaryCtaLabel" />
    </label>
    <label class="studio-field">
      <span>Botão secundário</span>
      <input type="text" maxlength={STUDIO_LIMITS.longText} value={section.secondaryCtaLabel} data-studio-path="home.contact.secondaryCtaLabel" />
    </label>
    <label class="studio-field studio-field--wide">
      <span>Destino do botão secundário</span>
      <input type="url" maxlength={STUDIO_LIMITS.longText} value={section.secondaryCtaHref} data-studio-path="home.contact.secondaryCtaHref" />
    </label>
  </div>
</PropertyPanel>
