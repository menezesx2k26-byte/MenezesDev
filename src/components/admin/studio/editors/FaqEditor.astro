---
import PropertyPanel from "../PropertyPanel.astro";
import { STUDIO_LIMITS } from "../../../../studio/validation";
import type { HomeFaqSection } from "../../../../studio/types";

interface Props {
  section: HomeFaqSection;
}

const { section } = Astro.props;
---

<PropertyPanel sectionKey="faq" title="FAQ" visible={section.visible} layout={section.layout}>
  <div class="studio-fields-grid">
    <label class="studio-field">
      <span>Chamada curta</span>
      <input
        type="text"
        maxlength={STUDIO_LIMITS.longText}
        value={section.eyebrow}
        data-studio-path="home.faq.eyebrow"
      />
    </label>
    <label class="studio-field studio-field--wide">
      <span>Título</span>
      <textarea maxlength={STUDIO_LIMITS.longText} rows="3" data-studio-path="home.faq.title"
        >{section.title}</textarea
      >
    </label>
  </div>

  <div class="studio-repeater" aria-label="Perguntas frequentes">
    {
      section.items.map((item, index) => (
        <section class="studio-repeater__item">
          <div class="studio-fields-grid">
            <label class="studio-field studio-field--wide">
              <span>Pergunta</span>
              <input
                type="text"
                maxlength={STUDIO_LIMITS.longText}
                value={item.question}
                data-studio-path={`home.faq.items.${index}.question`}
              />
            </label>
            {item.answer.map((paragraph, answerIndex) => (
              <label class="studio-field studio-field--wide">
                <span>Resposta {answerIndex + 1}</span>
                <textarea
                  maxlength={STUDIO_LIMITS.longText}
                  rows="3"
                  data-studio-path={`home.faq.items.${index}.answer.${answerIndex}`}
                >
                  {paragraph}
                </textarea>
              </label>
            ))}
            <label class="studio-control studio-control--toggle">
              <span>
                <strong>Visível</strong>
              </span>
              <input
                type="checkbox"
                checked={item.visible}
                data-studio-value-type="boolean"
                data-studio-path={`home.faq.items.${index}.visible`}
              />
            </label>
          </div>
        </section>
      ))
    }
  </div>
</PropertyPanel>
