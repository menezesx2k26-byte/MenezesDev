---
import PropertyPanel from "../PropertyPanel.astro";
import { STUDIO_LIMITS } from "../../../../studio/validation";
import type { HomeHeroSection } from "../../../../studio/types";

interface Props {
  section: HomeHeroSection;
}

const { section } = Astro.props;
---

<PropertyPanel sectionKey="hero" title="Hero" visible={section.visible} layout={section.layout}>
  <div class="studio-fields-grid">
    <label class="studio-field">
      <span>Chamada curta</span>
      <input
        type="text"
        maxlength={STUDIO_LIMITS.longText}
        value={section.eyebrow}
        data-studio-path="home.hero.eyebrow"
      />
    </label>

    <label class="studio-field studio-field--wide">
      <span>Título</span>
      <textarea maxlength={STUDIO_LIMITS.longText} rows="3" data-studio-path="home.hero.title">{section.title}</textarea>
    </label>

    <label class="studio-field studio-field--wide">
      <span>Texto de apoio</span>
      <textarea maxlength={STUDIO_LIMITS.longText} rows="4" data-studio-path="home.hero.lead">{section.lead}</textarea>
    </label>

    <label class="studio-field">
      <span>Botão principal</span>
      <input
        type="text"
        maxlength={STUDIO_LIMITS.longText}
        value={section.primaryCtaLabel}
        data-studio-path="home.hero.primaryCtaLabel"
      />
    </label>

    <label class="studio-field">
      <span>Botão secundário</span>
      <input
        type="text"
        maxlength={STUDIO_LIMITS.longText}
        value={section.secondaryCtaLabel}
        data-studio-path="home.hero.secondaryCtaLabel"
      />
    </label>

    <label class="studio-field studio-field--wide">
      <span>Destino do botão secundário</span>
      <input
        type="url"
        maxlength={STUDIO_LIMITS.longText}
        value={section.secondaryCtaHref}
        data-studio-path="home.hero.secondaryCtaHref"
      />
    </label>

    <label class="studio-field studio-field--wide">
      <span>Microcopy</span>
      <textarea maxlength={STUDIO_LIMITS.longText} rows="2" data-studio-path="home.hero.microcopy">{section.microcopy}</textarea>
    </label>
  </div>
</PropertyPanel>
