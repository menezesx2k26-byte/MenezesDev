---
import PropertyPanel from "../PropertyPanel.astro";
import { STUDIO_LIMITS } from "../../../../studio/validation";
import type { HomeServicesSection } from "../../../../studio/types";

interface Props {
  section: HomeServicesSection;
}

const { section } = Astro.props;
---

<PropertyPanel
  sectionKey="services"
  title="Serviços"
  visible={section.visible}
  layout={section.layout}
>
  <div class="studio-fields-grid">
    <label class="studio-field">
      <span>Chamada curta</span>
      <input
        type="text"
        maxlength={STUDIO_LIMITS.longText}
        value={section.eyebrow}
        data-studio-path="home.services.eyebrow"
      />
    </label>

    <label class="studio-field studio-field--wide">
      <span>Título</span>
      <textarea maxlength={STUDIO_LIMITS.longText} rows="3" data-studio-path="home.services.title"
        >{section.title}</textarea
      >
    </label>

    <label class="studio-field studio-field--wide">
      <span>Texto de apoio</span>
      <textarea maxlength={STUDIO_LIMITS.longText} rows="3" data-studio-path="home.services.lead"
        >{section.lead}</textarea
      >
    </label>
  </div>

  <div class="studio-repeater" aria-label="Serviços">
    {
      section.items.map((item, index) => (
        <section class="studio-repeater__item">
          <h3>{item.title || `Serviço ${index + 1}`}</h3>
          <div class="studio-fields-grid">
            <label class="studio-field">
              <span>Título</span>
              <input
                type="text"
                maxlength={STUDIO_LIMITS.longText}
                value={item.title}
                data-studio-path={`home.services.items.${index}.title`}
              />
            </label>
            <label class="studio-field studio-field--wide">
              <span>Descrição</span>
              <textarea
                maxlength={STUDIO_LIMITS.longText}
                rows="3"
                data-studio-path={`home.services.items.${index}.text`}
              >
                {item.text}
              </textarea>
            </label>
            {item.microcopy !== undefined && (
              <label class="studio-field studio-field--wide">
                <span>Microcopy</span>
                <input
                  type="text"
                  maxlength={STUDIO_LIMITS.longText}
                  value={item.microcopy}
                  data-studio-path={`home.services.items.${index}.microcopy`}
                />
              </label>
            )}
          </div>
        </section>
      ))
    }
  </div>
</PropertyPanel>
