---
import BaseLayout from "../layouts/BaseLayout.astro";
import MenezesHeader from "../components/MenezesHeader.astro";
import MenezesFooter from "../components/MenezesFooter.astro";
import "../styles/menezesdev.css";
---

<BaseLayout
  title="Página não encontrada — MenezesDev"
  description="A página solicitada não foi encontrada."
  theme="menezesdev"
  noindex
  fonts={["--font-manrope", "--font-inter"]}
  preloadFont="--font-manrope"
>
  <MenezesHeader />
  <main id="main-content">
    <section class="section">
      <div class="container section-heading">
        <p class="eyebrow">ERRO 404</p><h1>Página não encontrada.</h1><p class="lead">
          O endereço acessado não existe ou não está disponível.
        </p><a class="button" href="/">Voltar para a Home</a>
      </div>
    </section>
  </main>
  <MenezesFooter />
</BaseLayout>
