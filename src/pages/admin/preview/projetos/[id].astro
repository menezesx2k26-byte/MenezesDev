---
import ProjectCasePage from "../../../../components/ProjectCasePage.astro";
import { getRuntimeBindings } from "../../../../runtime/bindings";
import { requireStudioAdminContext } from "../../../../studio/http";
import {
  PREVIEW_CACHE_CONTROL,
  toDraftProjectPreview,
} from "../../../../studio/preview";
import { getDraft } from "../../../../studio/repository";
import type { SiteDocument } from "../../../../studio/types";
import type { PublicProjectView } from "../../../../studio/public-content";

Astro.response.headers.set("Cache-Control", PREVIEW_CACHE_CONTROL);
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow, noarchive");

const adminContext = requireStudioAdminContext({ isDev: import.meta.env.DEV });
if (!adminContext) Astro.response.status = 404;

let document: SiteDocument | null = null;
let project: PublicProjectView | null = null;
if (adminContext) {
  try {
    const { DB } = getRuntimeBindings();
    const draft = await getDraft(DB);
    document = draft.document;
    project = toDraftProjectPreview(draft.document, Astro.params.id ?? "");
  } catch {
    Astro.response.status = 404;
  }
}

const navigation = document
  ? document.navigation.filter((item) => item.visible).map(({ label, href }) => ({ label, href }))
  : [];
---

{
  document && project ? (
    <ProjectCasePage
      project={project}
      navigation={navigation}
      whatsappUrl={document.commercial.whatsappUrl}
      brandName={document.brand.name}
      tagline={document.brand.tagline}
      preview
    />
  ) : (
    <html lang="pt-BR">
      <head>
        <meta charset="UTF-8" />
        <meta name="robots" content="noindex, nofollow, noarchive" />
        <title>Prévia indisponível</title>
      </head>
      <body />
    </html>
  )
}
