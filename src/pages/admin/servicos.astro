---
import AdminLayout from "../../layouts/AdminLayout.astro";
import ConflictDialog from "../../components/admin/ConflictDialog.astro";
import ServicesEditor from "../../components/admin/services/ServicesEditor.astro";
import { getRuntimeBindings } from "../../runtime/bindings";
import { requireStudioAdminContext } from "../../studio/http";
import { getDraft, getPublished } from "../../studio/repository";

const adminContext = requireStudioAdminContext({ isDev: import.meta.env.DEV });
if (!adminContext) Astro.response.status = 404;

let draft: Awaited<ReturnType<typeof getDraft>> | null = null;
let baselineDocument: Awaited<ReturnType<typeof getPublished>>["document"] | null = null;
let loadError = false;

if (adminContext) {
  try {
    const { DB } = getRuntimeBindings();
    const [loadedDraft, published] = await Promise.all([getDraft(DB), getPublished(DB)]);
    draft = loadedDraft;
    baselineDocument = published.document;
  } catch {
    loadError = true;
  }
}

const ready = Boolean(adminContext && draft && baselineDocument && !loadError);
const initialStateJson =
  ready && draft && baselineDocument
    ? JSON.stringify({ document: draft.document, baseline: baselineDocument, revision: draft.revision })
        .replace(/&/g, "\\u0026")
        .replace(/</g, "\\u003c")
        .replace(/>/g, "\\u003e")
        .replace(/\u2028/g, "\\u2028")
        .replace(/\u2029/g, "\\u2029")
    : "";
---

{
  adminContext ? (
    <AdminLayout
      title="Serviços"
      description="Gerenciamento dos serviços do MenezesDev Studio."
      saveLabel={ready ? "Rascunho carregado" : "Serviços indisponíveis"}
      publicationLabel="Publicação separada do rascunho"
      statusTone={ready ? "neutral" : "error"}
    >
      {ready && draft ? (
        <>
          <section class="admin-page-heading" aria-labelledby="services-heading">
            <p class="admin-kicker">Oferta</p>
            <h2 id="services-heading">Serviços do site.</h2>
            <p>Reordene e edite sem apagar itens. Pelo menos um serviço precisa permanecer visível.</p>
          </section>

          <div data-services-plans-root>
            <script id="studio-initial-state" type="application/json" is:inline set:html={initialStateJson} />
            <ServicesEditor services={draft.document.home.services.items} />
          </div>
          <ConflictDialog />

          <script>
            import { setupServicesPlansController } from "../../studio/client/services-plans-controller";
            setupServicesPlansController();
            document.addEventListener("astro:page-load", setupServicesPlansController);
          </script>
        </>
      ) : (
        <section class="admin-panel admin-panel--full" role="alert">
          <span class="admin-panel__label">Serviços indisponíveis</span>
          <strong class="admin-panel__value">O rascunho não pôde ser carregado.</strong>
          <p class="admin-panel__detail">Nenhuma alteração foi feita. Verifique o estado do banco de dados.</p>
        </section>
      )}
    </AdminLayout>
  ) : (
    <html lang="pt-BR">
      <head>
        <meta charset="UTF-8" />
        <meta name="robots" content="noindex, nofollow, noarchive" />
        <title>Página não encontrada</title>
      </head>
      <body />
    </html>
  )
}
