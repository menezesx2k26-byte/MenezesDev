---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import PrismaeHeader from "../../../../components/PrismaeHeader.astro";
import PrismaeFooter from "../../../../components/PrismaeFooter.astro";
import PrismaeProcess from "../../../../components/PrismaeProcess.astro";
import PrismaeCta from "../../../../components/PrismaeCta.astro";
import "../../../../styles/prismae.css";
---

<BaseLayout
  title="Processos — Prismae"
  description="Fluxos mais claros para reduzir atrito e retrabalho."
  theme="prismae"
  noindex
  fonts={["--font-jakarta", "--font-inter"]}
  preloadFont="--font-jakarta"
>
  <PrismaeHeader />
  <main id="main-content">
    <section class="prismae-hero prismae-grid-bg">
      <div class="container prismae-hero__grid">
        <div>
          <p class="eyebrow">SOLUÇÕES · PROCESSOS</p><h1>Processos</h1><p class="lead">
            Fluxos mais claros para reduzir atrito e retrabalho.
          </p>
        </div><div class="prismae-diagram" aria-label="Fluxo de processo">
          <div class="surface-card"><strong>Diagnóstico</strong></div><div class="surface-card">
            <strong>Implementação</strong>
          </div><div class="surface-card"><strong>Acompanhamento</strong></div>
        </div>
      </div>
    </section>
    <section class="section"><div class="container"><PrismaeProcess /></div></section>
    <section class="section--compact"><div class="container"><PrismaeCta /></div></section>
  </main>
  <PrismaeFooter />
</BaseLayout>
