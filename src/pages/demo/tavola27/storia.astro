---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TavolaHeader from "../../../components/TavolaHeader.astro";
import TavolaFooter from "../../../components/TavolaFooter.astro";
import "../../../styles/tavola.css";
---

<BaseLayout
  title="Nossa história — Tavola 27"
  description="História demonstrativa do conceito fictício Tavola 27."
  image="/assets/demos/tavola27/tavola27-space-03.webp"
  theme="tavola"
  noindex
  fonts={["--font-cormorant", "--font-manrope"]}
  preloadFont="--font-cormorant"
>
  <TavolaHeader />
  <main id="main-content">
    <section class="tavola-page-hero">
      <div class="container tavola-page-hero__grid">
        <div>
          <p class="eyebrow">NOSSA HISTÓRIA</p><h1>Uma mesa criada para reunir pessoas.</h1><p
            class="lead"
          >
            Tavola 27 nasceu de uma ideia simples: comida boa pede tempo — para preparar,
            compartilhar e lembrar.
          </p>
        </div><img
          src="/assets/demos/tavola27/tavola27-space-03.webp"
          width="1200"
          height="1500"
          alt="Mesa para duas pessoas junto à janela em canto íntimo do restaurante Tavola 27."
          fetchpriority="high"
        />
      </div>
    </section>
    <section class="section">
      <div class="container tavola-manifesto">
        <div>
          <p class="eyebrow">NOSSA COZINHA</p><h2>Poucos ingredientes.<br />Muito cuidado.</h2><p
            class="lead"
          >
            A melhor comida italiana começa antes do prato: ingredientes bem escolhidos, massa feita
            todos os dias e respeito pelo tempo de cada receita.
          </p>
        </div><div class="tavola-manifesto__image">
          <img
            src="/assets/demos/tavola27/tavola27-detail-02.webp"
            width="1536"
            height="1024"
            alt="Louça artesanal, linho, ervas, farinha e azeite preparados para o serviço."
            loading="lazy"
          />
        </div>
      </div>
    </section>
    <section class="section--compact">
      <div class="container tavola-story">
        <img
          src="/assets/demos/tavola27/tavola27-space-01.webp"
          width="1536"
          height="960"
          alt="Salão do Tavola 27 com paredes creme e verdes, mesas de madeira e luz natural."
          loading="lazy"
        /><img
          src="/assets/demos/tavola27/tavola27-detail-01.webp"
          width="1536"
          height="1024"
          alt="Mãos cortando massa fresca em tiras sobre bancada enfarinhada na cozinha."
          loading="lazy"
        />
      </div><div class="button-row" style="margin-top:2rem">
        <a class="button" href="/demo/tavola27/contact#reservas">Reservar mesa</a>
      </div>
    </section>
  </main>
  <TavolaFooter />
</BaseLayout>
