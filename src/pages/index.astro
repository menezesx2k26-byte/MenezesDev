---
import BaseLayout from "../layouts/BaseLayout.astro";
import MenezesHeader from "../components/MenezesHeader.astro";
import MenezesFooter from "../components/MenezesFooter.astro";
import CommercialAction from "../components/CommercialAction.astro";
import { ArrowRight, Check } from "lucide-astro";
import {
  capabilities,
  faqs,
  plans,
  processSteps,
  services,
  socialComparison,
  trustItems,
} from "../data/home";
import { projects } from "../data/projects";
import { siteConfig } from "../config/site";
import "../styles/menezesdev.css";
---

<BaseLayout
  title={siteConfig.metadata.title}
  description={siteConfig.metadata.description}
  theme="menezesdev"
  fonts={["--font-manrope", "--font-inter"]}
  preloadFont="--font-manrope"
>
  <MenezesHeader />
  <main id="main-content">
    <section class="md-hero">
      <div class="container md-hero__grid">
        <div class="md-hero__copy">
          <p class="eyebrow">DESENVOLVIMENTO WEB PARA NEGÓCIOS</p>
          <h1>Seu negócio merece um site <span>à altura.</span></h1>
          <p class="lead">
            Sites rápidos, modernos e profissionais para empresas que querem transformar presença
            digital em mais credibilidade, contatos e oportunidades.
          </p>
          <div class="button-row">
            <CommercialAction label="Quero meu site" showPendingNote />
            <a class="button button--secondary" href="#projetos"
              >Ver projetos <ArrowRight aria-hidden="true" size={18} /></a
            >
          </div>
          <div class="md-hero__microcopy">
            <strong>Projetos a partir de R$600.</strong>
            <span>Design profissional · Responsivo · SEO técnico · HTTPS</span>
          </div>
        </div>
        <div class="md-mosaic" aria-label="Três conceitos visuais MenezesDev">
          <div class="md-mosaic__item">
            <img
              src="/assets/demos/m47/m47-hero.webp"
              width="1536"
              height="960"
              alt="Conceito M47 Barber"
              fetchpriority="high"
            />
          </div>
          <div class="md-mosaic__item">
            <img
              src="/assets/demos/tavola27/tavola27-hero.webp"
              width="1536"
              height="960"
              alt="Conceito Tavola 27"
              fetchpriority="low"
            />
          </div>
          <div class="md-mosaic__item">
            <img
              src="/assets/demos/prismae/prismae-hero-graphic.svg"
              width="960"
              height="720"
              alt="Conceito gráfico Prismae"
              fetchpriority="low"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="md-trust" aria-label="Características dos projetos">
      <div class="container md-trust__grid">
        {
          trustItems.map((item) => (
            <div class="md-trust__item">
              <>
                <Check aria-hidden="true" size={22} />
                <strong>{item.title}</strong>
                <span>{item.text}</span>
              </>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section" aria-labelledby="problema-title">
      <div class="container md-problem__grid">
        <div>
          <p class="eyebrow">PRESENÇA DIGITAL</p>
          <h2 id="problema-title">Ter Instagram não é ter presença digital completa.</h2>
          <p class="lead">
            Redes sociais são importantes, mas pertencem a plataformas de terceiros.
          </p>
          <p>
            Um site próprio organiza sua marca, apresenta seus serviços e oferece ao cliente um
            lugar profissional para encontrar tudo o que precisa.
          </p>
          <p><strong>Seu site funciona como a sede digital do seu negócio.</strong></p>
        </div>
        <div class="md-compare">
          <article class="surface-card">
            <h3>Apenas redes sociais</h3>
            <ul>{socialComparison.social.map((item) => <li>{item}</li>)}</ul>
          </article>
          <article class="surface-card">
            <h3>Com um site próprio</h3>
            <ul>{socialComparison.website.map((item) => <li>{item}</li>)}</ul>
          </article>
        </div>
      </div>
    </section>

    <section class="section--compact" id="projetos" aria-labelledby="projects-title">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">PROJETOS</p>
          <h2 id="projects-title">
            Sites que parecem caros.<br />Sem precisar custar uma fortuna.
          </h2>
          <p class="lead">Design profissional não deveria ser exclusividade de grandes empresas.</p>
          <p>Cada projeto é desenvolvido para combinar identidade, clareza e desempenho.</p>
        </div>
        <div class="md-projects">
          {
            projects.map((project, index) => (
              <article
                class:list={[
                  "md-project",
                  `md-project--${project.slug === "tavola-27" ? "tavola" : project.slug}`,
                ]}
              >
                <div class="md-project__copy">
                  <p class="eyebrow">{project.category}</p>
                  <p class="demo-disclosure">{project.label}</p>
                  <h3>{project.headline}</h3>
                  <p class="lead">{project.description}</p>
                  <ul class="tag-list">
                    {project.tags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                  <p class="md-project__meta">{project.plan}</p>
                  <a class="button" href={`/projetos/${project.slug}`}>
                    Ver projeto <ArrowRight aria-hidden="true" size={18} />
                  </a>
                </div>
                <div class="md-project__media">
                  <img
                    src={project.cover.src}
                    width={project.cover.width}
                    height={project.cover.height}
                    alt={project.cover.alt}
                    loading="lazy"
                  />
                  {index === 1 && (
                    <img
                      src="/assets/demos/tavola27/tavola27-food-01.webp"
                      width="1200"
                      height="1500"
                      alt="Tagliatelle ao ragu do conceito Tavola 27"
                      loading="lazy"
                    />
                  )}
                </div>
              </article>
            ))
          }
        </div>
        <div class="surface-card md-portfolio-cta">
          <h3>Quer um projeto com a identidade do seu negócio?</h3>
          <CommercialAction label="Solicitar orçamento" showPendingNote />
        </div>
      </div>
    </section>

    <section class="section" id="servicos" aria-labelledby="services-title">
      <div class="container md-split">
        <div class="section-heading">
          <p class="eyebrow">SERVIÇOS</p>
          <h2 id="services-title">Do primeiro clique ao site publicado.</h2>
          <p class="lead">Desenvolvimento completo, da estrutura visual à publicação.</p>
        </div>
        <div class="md-services">
          {
            services.map((service, index) => (
              <article class="md-service">
                <>
                  <span>0{index + 1}</span>
                  <div>
                    <>
                      <h3>{service.title}</h3>
                      <p>{service.text}</p>
                    </>
                  </div>
                  <small>{service.microcopy}</small>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" id="processo" aria-labelledby="process-title">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">COMO FUNCIONA</p>
          <h2 id="process-title">Seu novo site em quatro etapas.</h2>
          <p class="lead">Um processo simples, claro e organizado do início ao lançamento.</p>
        </div>
        <div class="md-process">
          {
            processSteps.map((step) => (
              <article>
                <>
                  <span class="md-process__number">{step.number}</span>
                  <h3>{step.title}</h3>
                  <p>{step.text}</p>
                </>
              </article>
            ))
          }
        </div>
        <p class="md-process-note">
          Você acompanha o projeto e possui até duas rodadas de revisão dentro do escopo contratado.
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="capabilities-title">
      <div class="container md-split">
        <div class="section-heading">
          <p class="eyebrow">POR DENTRO</p>
          <h2 id="capabilities-title">Bonito por fora.<br />Bem construído por dentro.</h2>
          <p class="lead">
            Um site profissional precisa fazer mais do que simplesmente parecer bom.
          </p>
          <p>
            A estrutura técnica também influencia velocidade, experiência, manutenção e presença nos
            mecanismos de busca.
          </p>
          <strong>Desenvolvido para ser rápido.</strong>
        </div>
        <div class="md-capabilities">
          {
            capabilities.map((item) => (
              <article class="surface-card">
                <>
                  <Check aria-hidden="true" size={22} />
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" id="planos" aria-labelledby="plans-title">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">PLANOS</p>
          <h2 id="plans-title">Um site para cada momento do seu negócio.</h2>
          <p class="lead">
            Comece com o que sua empresa precisa hoje e evolua quando fizer sentido.
          </p>
          <p>Todos os valores representam preços iniciais e podem variar conforme o escopo.</p>
        </div>
        <div class="md-plans">
          {
            plans.map((plan) => (
              <article
                class:list={["surface-card md-plan", { "md-plan--recommended": plan.recommended }]}
              >
                {plan.recommended && <span class="md-plan__badge">RECOMENDADO</span>}
                <h3>{plan.name}</h3>
                <p class="md-plan__price">{plan.price}</p>
                <p>{plan.description}</p>
                <strong>{plan.highlight}</strong>
                <details>
                  <>
                    <summary>O que inclui</summary>
                    <ul>
                      {plan.includes.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </>
                </details>
                <CommercialAction label={plan.cta} class="button button--wide" showPendingNote />
              </article>
            ))
          }
        </div>
        <article class="surface-card md-custom-plan">
          <div>
            <h3>Precisa de algo além de um site convencional?</h3><p>
              Também desenvolvemos projetos com banco de dados, dashboards, áreas administrativas,
              autenticação, integrações e outras funcionalidades específicas.
            </p><strong>Projetos personalizados a partir de R$2.500.</strong>
          </div>
          <CommercialAction label="Contar sobre meu projeto" showPendingNote />
        </article>
        <p class="md-process-note">
          Domínio, serviços pagos de terceiros e funcionalidades fora do escopo podem gerar custos
          adicionais. Nenhum serviço externo será contratado sem alinhamento prévio.
        </p>
      </div>
    </section>

    <section class="section" id="faq" aria-labelledby="faq-title">
      <div class="container md-split">
        <div class="section-heading">
          <p class="eyebrow">DÚVIDAS FREQUENTES</p><h2 id="faq-title">
            Antes de começar, talvez você queira saber.
          </h2>
        </div>
        <div class="md-faq">
          {
            faqs.map((item) => (
              <details>
                <>
                  <summary>{item.question}</summary>
                  <div class="md-faq__answer">
                    {item.answer.map((paragraph) => (
                      <p>{paragraph}</p>
                    ))}
                  </div>
                </>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section--compact">
      <div class="container surface-card md-final-cta">
        <div>
          <p class="eyebrow">VAMOS COMEÇAR?</p><h2>
            Sua empresa já existe.<br />Agora faça ela existir na internet.
          </h2><p class="lead">Conte um pouco sobre seu negócio e o que você precisa.</p><p>
            A partir disso, analisamos o projeto e indicamos a solução mais adequada.
          </p><strong>Orçamento sem compromisso.</strong>
        </div>
        <div class="button-row">
          <CommercialAction label="Falar pelo WhatsApp" showPendingNote /><a
            class="button button--secondary"
            href="#planos">Ver planos</a
          >
        </div>
      </div>
    </section>
  </main>
  <MenezesFooter />
  <script>
    const setupFaq = () => {
      const detailsItems = [...document.querySelectorAll<HTMLDetailsElement>(".md-faq details")];
      const summaries = detailsItems
        .map((details) => details.querySelector<HTMLElement>("summary"))
        .filter((summary): summary is HTMLElement => Boolean(summary));

      detailsItems.forEach((details) => {
        if (details.dataset.ready === "true") return;
        details.dataset.ready = "true";
        const summary = details.querySelector<HTMLElement>("summary");
        if (!summary) return;
        const syncExpanded = () => summary.setAttribute("aria-expanded", String(details.open));
        syncExpanded();
        details.addEventListener("toggle", syncExpanded);
        summary.addEventListener("keydown", (event) => {
          if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            details.open = !details.open;
            return;
          }

          const currentIndex = summaries.indexOf(summary);
          const focusSummary = (index: number) => {
            event.preventDefault();
            summaries[index]?.focus();
          };

          if (event.key === "ArrowDown" || event.key === "ArrowRight") {
            focusSummary((currentIndex + 1) % summaries.length);
          } else if (event.key === "ArrowUp" || event.key === "ArrowLeft") {
            focusSummary((currentIndex - 1 + summaries.length) % summaries.length);
          } else if (event.key === "Home") {
            focusSummary(0);
          } else if (event.key === "End") {
            focusSummary(summaries.length - 1);
          }
        });
      });
    };
    setupFaq();
    document.addEventListener("astro:page-load", setupFaq);
  </script>
</BaseLayout>
