---
import ProjectCasePage from "../../components/ProjectCasePage.astro";
import { getRuntimeBindings } from "../../runtime/bindings";
import { getPublishedSiteDocument, toPublicProjectView } from "../../studio/public-content";

const { DB } = getRuntimeBindings();
const document = await getPublishedSiteDocument(DB);
const project = toPublicProjectView(document, "tavola-27");
const navigation = document.navigation
  .filter((item) => item.visible)
  .map(({ label, href }) => ({ label, href }));
---

<ProjectCasePage
  project={project}
  navigation={navigation}
  whatsappUrl={document.commercial.whatsappUrl}
  brandName={document.brand.name}
  tagline={document.brand.tagline}
/>
