{
  "name": "@menezesdev/mcp-image",
  "version": "0.1.0",
  "private": true,
  "description": "MCP STDIO image pipeline for MenezesDev projects",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    ".env.example",
    "config"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/index.js",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.build.json && node --test tests/*.test.mjs && node scripts/smoke-client.mjs",
    "smoke": "node scripts/smoke-client.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "dotenv": "17.4.2",
    "openai": "7.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "26.2.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.19.0"
}
